{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/atlas", "destination": "/atlas-documentation/", "permanent": true },
    { "source": "/atlas/", "destination": "/atlas-documentation/", "permanent": true },
    { "source": "/atlas-files", "destination": "/atlas-documentation/", "permanent": true },
    { "source": "/atlas-files/", "destination": "/atlas-documentation/", "permanent": true },
    { "source": "/atlas-guide", "destination": "/atlas-documentation/", "permanent": true },
    { "source": "/atlas-guide/", "destination": "/atlas-documentation/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
